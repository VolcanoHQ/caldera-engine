# ==============================================================================
# Firespeaker / Caldera Engine -- Environment Configuration
# ==============================================================================
# Copy this file to `.env` (which is gitignored) and fill in real values as
# needed. Every variable below has a safe placeholder/default baked into the
# code, so the app runs fine with none of this set -- this file just documents
# what's tunable and where to plug in real credentials when you have them.
#
#     cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# LLM enrichment (src/llm_client.py) -- optional, free-tier fallback chain:
# Gemini Flash -> Groq Llama-3.1-8B -> local Ollama -> heuristics only.
# Leave blank to run on heuristics only (CALDERA_LLM_ENRICHMENT=off also disables it).
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_API_KEY_PAID=
GROQ_API_KEY=
CALDERA_LLM_ENRICHMENT=on
CALDERA_OLLAMA_MODEL=

# ------------------------------------------------------------------------------
# Voice Marketplace client (src/marketplace_client.py)
# ------------------------------------------------------------------------------
# The Voice Marketplace is now its own standalone product ("Volcano Studios
# Voice Marketplace" -- separate repo, runs via Docker), not part of this
# codebase. This app talks to it purely over HTTP. Point this at wherever
# that service is running (its docker-compose.yml publishes port 8010 by
# default on localhost).
MARKETPLACE_API_URL=http://localhost:8010

# NOTE: Stripe Secret/Publishable/Webhook keys, platform fee percent, and the
# Checkout/Connect redirect URLs now belong entirely to the standalone
# marketplace product's own .env (see its .env.example) -- Stripe should be
# configured to call that product's webhook endpoint directly, not this app.
# src/voice_marketplace.py and src/marketplace_payments.py in this repo are
# kept only for their existing test coverage / historical reference; they are
# no longer the live backing implementation for /api/marketplace/* or the
# director casting flow (see src/marketplace_client.py).

# ------------------------------------------------------------------------------
# Audio synthesis / TTS device policy (src/voice_synthesizer.py, src/boot_check.py)
# ------------------------------------------------------------------------------
# auto | cpu | cuda -- "auto" detects a GPU if available.
CALDERA_TTS_DEVICE=auto
# Set to "mock" only in tests/dev to skip real model inference.
CALDERA_TTS=

# ------------------------------------------------------------------------------
# Per-voice XTTS fine-tuning, premium tier (src/voice_finetune.py,
# scripts/finetune_xtts_voice.py). Real training requires a CUDA GPU and the
# coqui-tts training extras; not exercised in most dev sandboxes.
# ------------------------------------------------------------------------------
# Minimum accumulated corpus (minutes) before a fine-tune job is allowed to start.
CALDERA_FINETUNE_MIN_MINUTES=30
# Training epochs / batch size passed to the GPT-decoder fine-tune recipe.
CALDERA_FINETUNE_EPOCHS=6
CALDERA_FINETUNE_BATCH_SIZE=4
# Max number of fine-tuned checkpoints kept loaded in memory at once
# (voice_synthesizer.py's per-character model cache, LRU-evicted).
CALDERA_FINETUNE_MODEL_CACHE_SIZE=2

# Feature toggles (default on) -- set to "off"/"0"/"false" to disable.
CALDERA_MUSICGEN=on
CALDERA_SFXGEN=on
CALDERA_IMAGEGEN=on

# ------------------------------------------------------------------------------
# Local vLLM server (src/vllm_client.py) -- optional self-hosted inference backend.
# ------------------------------------------------------------------------------
VLLM_API_URL=http://localhost:8000/v1
VLLM_MODEL_NAME=meta-llama/Llama-3-8B-Instruct
